<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1A">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Safe Zone Editor"
        android:textColor="#F1F5F9"
        android:textSize="22sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#1A3D7EFE" />

    <com.ghosttouch.guardian.ZoneEditorView
        android:id="@+id/zoneEditorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/zoneList"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#1AFFFFFF"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnAddZone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add Zone"
            android:layout_marginEnd="8dp"
            android:background="#1A00E676"
            android:textColor="#F1F5F9" />

        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear All"
            android:layout_marginEnd="8dp"
            android:background="#1AFF4B4B"
            android:textColor="#F1F5F9" />

        <Button
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Done"
            android:background="#1A3D7EFE"
            android:textColor="#F1F5F9" />
    </LinearLayout>

</LinearLayout>