<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#F1F5F9"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initialising…"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Pause Guardian"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- stats overlay -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStats"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Stats Overlay: OFF"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- s-pen mode -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPen"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="S-Pen Mode: OFF"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- overlay permission -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverlay"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Overlay permission"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="12dp" />

        <!-- battery -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Battery unrestricted"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            android:layout_marginBottom="24dp" />

        <!-- how it works -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How detection works:\n\n1. Physical impact (accelerometer) → allow\n2. Flesh contact + round shape → allow\n3. Gradual pressure ramp → allow\n4. Burst at same location → block\n5. S-Pen echo window → block\n6. Scoring: 3+ ghost signals, 0 human → block\n\nS-Pen Mode: blocks ALL capacitive input."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>
</ScrollView>
