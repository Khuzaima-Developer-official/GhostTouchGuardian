<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amoled_black"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- ═══ 1. TOP HEADER & SCREEN LOCK STATUS ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHOST TOUCH TEST LAB"
                android:textColor="@color/accent_cyan"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Screen Locked: Ghost clicks cannot exit or close app"
                android:textColor="@color/valid_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFlushLab"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Clear"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/accent_cyan" />
    </LinearLayout>

    <!-- ═══ 2. 3-MODE SELECTOR TABS ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLabIdleMode"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="1: Hands-Free"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_blue"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLabEchoMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="2: Finger Echo"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/card_border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLabCalibrateMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1.2"
            android:minHeight="0dp"
            android:text="3: Calibrate Screen"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/card_border" />
    </LinearLayout>

    <!-- ═══ 3. TELEMETRY STRIP ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghost Taps"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvLabGhostCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/ghost_red"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trailing Echoes"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvLabEchoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFA726"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@color/card_border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM Buffer"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~3.6 KB"
                    android:textColor="@color/valid_green"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ 4. DYNAMIC INSTRUCTION BANNER ═══ -->
    <TextView
        android:id="@+id/tvLabInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#0F1A2B"
        android:padding="8dp"
        android:text="Hands-Off Test: Phone on table. Any touch is auto-flagged as Ghost."
        android:textAlignment="center"
        android:textColor="@color/accent_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- ═══ 5. TOUCH CANVAS ARENA ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#06080E">

        <com.antigravity.ghosttouchguardian.ui.TouchCanvasView
            android:id="@+id/labTouchCanvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ═══ 6. HUMAN EXIT SLIDER (GHOST-PROOF) ═══ -->
    <com.antigravity.ghosttouchguardian.ui.HumanExitSliderView
        android:id="@+id/humanExitSlider"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp" />

</LinearLayout>
