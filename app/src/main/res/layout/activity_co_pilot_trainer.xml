<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coPilotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A11">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/coPilotHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvCoPilotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S23 ULTRA AI CO-PILOT (TEACH AI)"
            android:textColor="#00E5FF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCoPilotSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="User as 'Half-Brain': Screen par jahan bhi touch ho, AI apna faisla dikhayega. Agar ghalti ho to 'Mark as Ghost' dabayein taake AI foran seekhe!"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Telemetry Badges Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#0D1220"
        app:cardCornerRadius="14dp"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/coPilotHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Corrections"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvUserCorrectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="#1E293B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water Glitch Memory"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvWaterMemoryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Signatures"
                    android:textColor="#FF5252"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:background="#1E293B" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Status"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvBrainState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LEARNING"
                    android:textColor="#22C55E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fast Mode Selector Bar (One-Click Batch Modes) -->
    <LinearLayout
        android:id="@+id/modeSelectorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/cardTelemetry">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAutoGhost"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🔴 All = Ghost"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#FF5252" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeInteractive"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:padding="0dp"
            android:backgroundTint="#2563EB"
            android:text="✋ 1-by-1 Mode"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAutoFinger"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="🟢 All = Finger"
            android:textColor="#22C55E"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="#22C55E" />
    </LinearLayout>

    <!-- Visual Target Canvas Arena: Area where touch ripple circles appear -->
    <FrameLayout
        android:id="@+id/arenaContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/modeSelectorBar"
        app:layout_constraintBottom_toTopOf="@+id/decisionPanel">

        <TextView
            android:id="@+id/tvArenaHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="TOUCH SCREEN ANYWHERE\nOR WAIT FOR WATER GLITCH...\n\nEvery touch will be captured, marked, and analyzed in real-time."
            android:textColor="#334155"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- Dynamic touch ring view -->
        <View
            android:id="@+id/touchRingView"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/badge_cyan"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Decision & 1-Tap Teaching Feedback Panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/decisionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="16dp"
        app:strokeColor="#2563EB"
        app:strokeWidth="1.5dp"
        app:layout_constraintBottom_toTopOf="@+id/humanExitSlider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLiveVerdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waiting for touch..."
                android:textColor="#94A3B8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTouchDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Touch glass anywhere on S23 Ultra to evaluate"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- User Supervisory Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAsGhost"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#EF4444"
                    android:text="⚠️ THIS IS GHOST!"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAsFinger"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#22C55E"
                    android:text="✅ REAL FINGER"
                    android:textColor="#070A11"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Batch Action Buttons (One-Tap Fast Workflows) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThisFingerRestGhost"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="🎯 Only This Finger (Rest=Ghost)"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#38BDF8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMarkAllRecentAsGhost"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="⚡ All Recent = Ghost"
                    android:textColor="#FF5252"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#FF5252" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Slide to exit -->
    <com.antigravity.ghosttouchguardian.ui.HumanExitSliderView
        android:id="@+id/humanExitSlider"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
